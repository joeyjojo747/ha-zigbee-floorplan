{
  "name": "zigbee-floorplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Home Assistant add-on that shows the Zigbee2MQTT mesh on a floorplan",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build",
    "test": "vitest run",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
